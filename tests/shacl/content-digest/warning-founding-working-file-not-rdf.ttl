@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<https://example.test/item/_knop> a sflo:Knop ;
  sflo:designatorPath "item" ;
  sflo:hasKnopMetadata <https://example.test/item/_knop/_meta> ;
  sflo:hasKnopInventory <https://example.test/item/_knop/_inventory> ;
  sflo:hasFoundingReferentData <https://example.test/item/_knop/_founding> .

<https://example.test/item/_knop/_meta> a sflo:KnopMetadata .

<https://example.test/item/_knop/_inventory> a sflo:KnopInventory .

<https://example.test/item/_knop/_founding>
  a sflo:FoundingReferentData, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <https://example.test/item/_knop/_founding/data.ttl> .

<https://example.test/item/_knop/_founding/data.ttl> a sflo:LocatedFile .
