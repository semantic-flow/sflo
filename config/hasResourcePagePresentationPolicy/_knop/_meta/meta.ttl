@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/hasResourcePagePresentationPolicy/_knop> a sflo:Knop ;
  sflo:designatorPath "config/hasResourcePagePresentationPolicy" ;
  sflo:hasWorkingKnopInventoryFile <config/hasResourcePagePresentationPolicy/_knop/_inventory/inventory.ttl> .
