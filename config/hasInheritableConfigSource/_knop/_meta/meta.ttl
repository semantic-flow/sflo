@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/hasInheritableConfigSource/_knop> a sflo:Knop ;
  sflo:designatorPath "config/hasInheritableConfigSource" ;
  sflo:hasWorkingKnopInventoryFile <config/hasInheritableConfigSource/_knop/_inventory/inventory.ttl> .
