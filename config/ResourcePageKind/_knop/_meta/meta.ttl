@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/ResourcePageKind/_knop> a sflo:Knop ;
  sflo:designatorPath "config/ResourcePageKind" ;
  sflo:hasWorkingKnopInventoryFile <config/ResourcePageKind/_knop/_inventory/inventory.ttl> .
