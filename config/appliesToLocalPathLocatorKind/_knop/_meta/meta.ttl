@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/appliesToLocalPathLocatorKind/_knop> a sflo:Knop ;
  sflo:designatorPath "config/appliesToLocalPathLocatorKind" ;
  sflo:hasWorkingKnopInventoryFile <config/appliesToLocalPathLocatorKind/_knop/_inventory/inventory.ttl> .
