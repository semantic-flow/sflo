@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/MeshConfig/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <config/MeshConfig/_knop/_sources/sources.ttl> ;
  sflo:hasSourceBinding <config/MeshConfig/_knop/_sources#extraction-source> .

<config/MeshConfig/_knop/_sources#extraction-source> a sflo:ExtractionSource ;
  sflo:hasTargetArtifact <config> ;
  sflo:hasRequestedTargetState <config/releases/v0.2.0> ;
  sflo:hasResolutionObservation <config/MeshConfig/_knop/_sources#extraction-source-observation-001> .

<config/MeshConfig/_knop/_sources#extraction-source-observation-001> a sflo:ArtifactResolutionObservation ;
  sflo:hasObservedTargetState <config/releases/v0.2.0> ;
  sflo:hasObservedTargetManifestation <config/releases/v0.2.0/ttl> ;
  sflo:hasObservedTargetLocatedFile <config/releases/v0.2.0/ttl/semantic-flow-config-ontology.ttl> ;
  sflo:observedContentDigest "sha256:5bfca0052b3611b0066ab95182f5d752d014e4e77af7f393f280495bd4932289" .

<config/MeshConfig/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .
