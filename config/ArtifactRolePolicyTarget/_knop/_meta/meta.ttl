@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/ArtifactRolePolicyTarget/_knop> a sflo:Knop ;
  sflo:designatorPath "config/ArtifactRolePolicyTarget" ;
  sflo:hasWorkingKnopInventoryFile <config/ArtifactRolePolicyTarget/_knop/_inventory/inventory.ttl> .
