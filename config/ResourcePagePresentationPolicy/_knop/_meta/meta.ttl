@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/ResourcePagePresentationPolicy/_knop> a sflo:Knop ;
  sflo:designatorPath "config/ResourcePagePresentationPolicy" ;
  sflo:hasWorkingKnopInventoryFile <config/ResourcePagePresentationPolicy/_knop/_inventory/inventory.ttl> .
