@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/hasPanelTargetClass/_knop> a sflo:Knop ;
  sflo:designatorPath "config/hasPanelTargetClass" ;
  sflo:hasWorkingKnopInventoryFile <config/hasPanelTargetClass/_knop/_inventory/inventory.ttl> .
