@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/hasDefaultResourcePagePresentationConfig/_knop> a sflo:Knop ;
  sflo:designatorPath "config/hasDefaultResourcePagePresentationConfig" ;
  sflo:hasWorkingKnopInventoryFile <config/hasDefaultResourcePagePresentationConfig/_knop/_inventory/inventory.ttl> .
