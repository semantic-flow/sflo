@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/hasPanelInclusionPolicy/_knop> a sflo:Knop ;
  sflo:designatorPath "config/hasPanelInclusionPolicy" ;
  sflo:hasWorkingKnopInventoryFile <config/hasPanelInclusionPolicy/_knop/_inventory/inventory.ttl> .
