@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/hasPolicyBinding/_knop> a sflo:Knop ;
  sflo:designatorPath "config/hasPolicyBinding" ;
  sflo:hasWorkingKnopInventoryFile <config/hasPolicyBinding/_knop/_inventory/inventory.ttl> .
