@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/ResourcePagePanelSelection/_knop> a sflo:Knop ;
  sflo:designatorPath "config/ResourcePagePanelSelection" ;
  sflo:hasWorkingKnopInventoryFile <config/ResourcePagePanelSelection/_knop/_inventory/inventory.ttl> .
