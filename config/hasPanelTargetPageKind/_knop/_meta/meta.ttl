@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/hasPanelTargetPageKind/_knop> a sflo:Knop ;
  sflo:designatorPath "config/hasPanelTargetPageKind" ;
  sflo:hasWorkingKnopInventoryFile <config/hasPanelTargetPageKind/_knop/_inventory/inventory.ttl> .
