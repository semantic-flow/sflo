@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/appliesToPolicyTarget/_knop> a sflo:Knop ;
  sflo:designatorPath "config/appliesToPolicyTarget" ;
  sflo:hasWorkingKnopInventoryFile <config/appliesToPolicyTarget/_knop/_inventory/inventory.ttl> .
