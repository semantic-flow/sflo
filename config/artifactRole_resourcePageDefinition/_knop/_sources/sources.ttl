@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/artifactRole_resourcePageDefinition/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <config/artifactRole_resourcePageDefinition/_knop/_sources/sources.ttl> ;
  sflo:hasSourceBinding <config/artifactRole_resourcePageDefinition/_knop/_sources#extraction-source> .

<config/artifactRole_resourcePageDefinition/_knop/_sources#extraction-source> a sflo:ExtractionSource ;
  sflo:targetArtifact <config> ;
  sflo:targetHistoricalState <config/releases/v0.3.0> ;
  sflo:hasResolutionObservation <config/artifactRole_resourcePageDefinition/_knop/_sources#extraction-source-observation-001> .

<config/artifactRole_resourcePageDefinition/_knop/_sources#extraction-source-observation-001> a sflo:ArtifactResolutionObservation ;
  sflo:observedArtifactResolutionSpec [
    a sflo:ArtifactResolutionSpec ;
    sflo:targetHistoricalState <config/releases/v0.3.0> ;
    sflo:targetManifestation <config/releases/v0.3.0/ttl> ;
    sflo:targetLocatedFile <config/releases/v0.3.0/ttl/semantic-flow-config-ontology.ttl>
  ] ;
  sflo:observedContentDigest "sha256:7d503eda9335342ce387282d3c02d1ebdd219ca4258ef8a85f09ede91e39f6cd" .

<config/artifactRole_resourcePageDefinition/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .
