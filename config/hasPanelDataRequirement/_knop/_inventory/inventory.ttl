@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<config/hasPanelDataRequirement/_knop> a sflo:Knop ;
  sflo:hasKnopMetadata <config/hasPanelDataRequirement/_knop/_meta> ;
  sflo:hasKnopInventory <config/hasPanelDataRequirement/_knop/_inventory> ;
  sflo:hasKnopSourceRegistry <config/hasPanelDataRequirement/_knop/_sources> ;
  sflo:hasExtractionSource <config/hasPanelDataRequirement/_knop/_sources#extraction-source> ;
  sflo:hasReferenceCatalog <config/hasPanelDataRequirement/_knop/_references> ;
  sflo:hasWorkingKnopInventoryFile <config/hasPanelDataRequirement/_knop/_inventory/inventory.ttl> ;
  sflo:hasResourcePage <config/hasPanelDataRequirement/_knop/index.html> .

<config/hasPanelDataRequirement/_knop/_meta> a sflo:KnopMetadata, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasArtifactHistory <config/hasPanelDataRequirement/_knop/_meta/_history001> ;
  sflo:currentArtifactHistory <config/hasPanelDataRequirement/_knop/_meta/_history001> ;
  sflo:nextHistoryOrdinal "2"^^xsd:nonNegativeInteger ;
  sflo:hasWorkingLocatedFile <config/hasPanelDataRequirement/_knop/_meta/meta.ttl> ;
  sflo:hasResourcePage <config/hasPanelDataRequirement/_knop/_meta/index.html> .

<config/hasPanelDataRequirement/_knop/_meta/_history001> a sflo:ArtifactHistory ;
  sflo:historyOrdinal "1"^^xsd:nonNegativeInteger ;
  sflo:hasHistoricalState <config/hasPanelDataRequirement/_knop/_meta/_history001/_s0001> ;
  sflo:latestHistoricalState <config/hasPanelDataRequirement/_knop/_meta/_history001/_s0001> ;
  sflo:nextStateOrdinal "2"^^xsd:nonNegativeInteger ;
  sflo:hasResourcePage <config/hasPanelDataRequirement/_knop/_meta/_history001/index.html> .

<config/hasPanelDataRequirement/_knop/_meta/_history001/_s0001> a sflo:HistoricalState ;
  sflo:stateOrdinal "1"^^xsd:nonNegativeInteger ;
  sflo:hasManifestation <config/hasPanelDataRequirement/_knop/_meta/_history001/_s0001/ttl> ;
  sflo:locatedFileForState <config/hasPanelDataRequirement/_knop/_meta/_history001/_s0001/ttl/meta.ttl> ;
  sflo:hasResourcePage <config/hasPanelDataRequirement/_knop/_meta/_history001/_s0001/index.html> .

<config/hasPanelDataRequirement/_knop/_meta/_history001/_s0001/ttl> a sflo:ArtifactManifestation, sflo:RdfDocument ;
  sflo:locatedFileForManifestation <config/hasPanelDataRequirement/_knop/_meta/_history001/_s0001/ttl/meta.ttl> ;
  sflo:hasResourcePage <config/hasPanelDataRequirement/_knop/_meta/_history001/_s0001/ttl/index.html> .

<config/hasPanelDataRequirement/_knop/_inventory> a sflo:KnopInventory, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasArtifactHistory <config/hasPanelDataRequirement/_knop/_inventory/_history001> ;
  sflo:currentArtifactHistory <config/hasPanelDataRequirement/_knop/_inventory/_history001> ;
  sflo:nextHistoryOrdinal "2"^^xsd:nonNegativeInteger ;
  sflo:hasWorkingLocatedFile <config/hasPanelDataRequirement/_knop/_inventory/inventory.ttl> ;
  sflo:hasResourcePage <config/hasPanelDataRequirement/_knop/_inventory/index.html> .

<config/hasPanelDataRequirement/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <config/hasPanelDataRequirement/_knop/_sources/sources.ttl> .

<config/hasPanelDataRequirement/_knop/_inventory/_history001> a sflo:ArtifactHistory ;
  sflo:historyOrdinal "1"^^xsd:nonNegativeInteger ;
  sflo:hasHistoricalState <config/hasPanelDataRequirement/_knop/_inventory/_history001/_s0001> ;
  sflo:latestHistoricalState <config/hasPanelDataRequirement/_knop/_inventory/_history001/_s0001> ;
  sflo:nextStateOrdinal "2"^^xsd:nonNegativeInteger ;
  sflo:hasResourcePage <config/hasPanelDataRequirement/_knop/_inventory/_history001/index.html> .

<config/hasPanelDataRequirement/_knop/_inventory/_history001/_s0001> a sflo:HistoricalState ;
  sflo:stateOrdinal "1"^^xsd:nonNegativeInteger ;
  sflo:hasManifestation <config/hasPanelDataRequirement/_knop/_inventory/_history001/_s0001/ttl> ;
  sflo:locatedFileForState <config/hasPanelDataRequirement/_knop/_inventory/_history001/_s0001/ttl/inventory.ttl> ;
  sflo:hasResourcePage <config/hasPanelDataRequirement/_knop/_inventory/_history001/_s0001/index.html> .

<config/hasPanelDataRequirement/_knop/_inventory/_history001/_s0001/ttl> a sflo:ArtifactManifestation, sflo:RdfDocument ;
  sflo:locatedFileForManifestation <config/hasPanelDataRequirement/_knop/_inventory/_history001/_s0001/ttl/inventory.ttl> ;
  sflo:hasResourcePage <config/hasPanelDataRequirement/_knop/_inventory/_history001/_s0001/ttl/index.html> .

<config/hasPanelDataRequirement/_knop/_meta/meta.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<config/hasPanelDataRequirement/_knop/_inventory/inventory.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<config/hasPanelDataRequirement/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<config/hasPanelDataRequirement/_knop/_references> a sflo:ReferenceCatalog, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <config/hasPanelDataRequirement/_knop/_references/references.ttl> .

<config/hasPanelDataRequirement/_knop/_references/references.ttl> a sflo:LocatedFile, sflo:RdfDocument .

