@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/hasMeshWorkspacePathRule/_knop> a sflo:Knop ;
  sflo:designatorPath "config/hasMeshWorkspacePathRule" ;
  sflo:hasWorkingKnopInventoryFile <config/hasMeshWorkspacePathRule/_knop/_inventory/inventory.ttl> .
