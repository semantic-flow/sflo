@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/hasConfigRoot> sflo:hasReferenceLink <config/hasConfigRoot/_knop/_references#reference001> .

<config/hasConfigRoot/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <config/hasConfigRoot> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <config/hasConfigRoot/_knop/_references#reference001-source> .

<config/hasConfigRoot/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:hasTargetArtifact <config> .
