@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/ExactArtifactPolicyTarget/_knop> a sflo:Knop ;
  sflo:designatorPath "config/ExactArtifactPolicyTarget" ;
  sflo:hasWorkingKnopInventoryFile <config/ExactArtifactPolicyTarget/_knop/_inventory/inventory.ttl> .
