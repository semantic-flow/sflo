@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/hasInheritableConfig/_knop> a sflo:Knop ;
  sflo:designatorPath "config/hasInheritableConfig" ;
  sflo:hasWorkingKnopInventoryFile <config/hasInheritableConfig/_knop/_inventory/inventory.ttl> .
