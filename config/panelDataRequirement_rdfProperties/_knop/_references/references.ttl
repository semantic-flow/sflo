@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/panelDataRequirement_rdfProperties> sflo:hasReferenceLink <config/panelDataRequirement_rdfProperties/_knop/_references#reference001> .

<config/panelDataRequirement_rdfProperties/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <config/panelDataRequirement_rdfProperties> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <config/panelDataRequirement_rdfProperties/_knop/_references#reference001-source> .

<config/panelDataRequirement_rdfProperties/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:targetArtifact <config> ;
  sflo:targetHistoricalState <config/releases/v0.3.0> .
