@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<config/targetsArtifact/_knop> a sflo:Knop ;
  sflo:designatorPath "config/targetsArtifact" ;
  sflo:hasWorkingKnopInventoryFile <config/targetsArtifact/_knop/_inventory/inventory.ttl> .
