@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/resolutionSpec/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/resolutionSpec" ;
  sflo:hasWorkingKnopInventoryFile <ontology/resolutionSpec/_knop/_inventory/inventory.ttl> .
