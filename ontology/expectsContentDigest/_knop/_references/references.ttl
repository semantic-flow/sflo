@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/expectsContentDigest> sflo:hasReferenceLink <ontology/expectsContentDigest/_knop/_references#reference001> .

<ontology/expectsContentDigest/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <ontology/expectsContentDigest> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <ontology/expectsContentDigest/_knop/_references#reference001-source> .

<ontology/expectsContentDigest/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:targetArtifact <ontology> ;
  sflo:targetHistoricalState <ontology/releases/v0.3.0> .
