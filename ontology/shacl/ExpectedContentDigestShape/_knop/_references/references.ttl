@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/shacl/ExpectedContentDigestShape> sflo:hasReferenceLink <ontology/shacl/ExpectedContentDigestShape/_knop/_references#reference001> .

<ontology/shacl/ExpectedContentDigestShape/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <ontology/shacl/ExpectedContentDigestShape> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <ontology/shacl/ExpectedContentDigestShape/_knop/_references#reference001-source> .

<ontology/shacl/ExpectedContentDigestShape/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:hasTargetArtifact <ontology/shacl> .
