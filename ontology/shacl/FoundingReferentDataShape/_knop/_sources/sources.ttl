@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/shacl/FoundingReferentDataShape/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <ontology/shacl/FoundingReferentDataShape/_knop/_sources/sources.ttl> ;
  sflo:hasSourceBinding <ontology/shacl/FoundingReferentDataShape/_knop/_sources#extraction-source> .

<ontology/shacl/FoundingReferentDataShape/_knop/_sources#extraction-source> a sflo:ExtractionSource ;
  sflo:targetArtifact <ontology/shacl> ;
  sflo:targetHistoricalState <ontology/shacl/releases/v0.5.0> ;
  sflo:hasResolutionObservation <ontology/shacl/FoundingReferentDataShape/_knop/_sources#extraction-source-observation-001> .

<ontology/shacl/FoundingReferentDataShape/_knop/_sources#extraction-source-observation-001> a sflo:ArtifactResolutionObservation ;
  sflo:observedArtifactResolutionSpec [
    a sflo:ArtifactResolutionSpec ;
    sflo:targetHistoricalState <ontology/shacl/releases/v0.5.0> ;
    sflo:targetManifestation <ontology/shacl/releases/v0.5.0/ttl> ;
    sflo:targetLocatedFile <ontology/shacl/releases/v0.5.0/ttl/semantic-flow-core-shacl.ttl>
  ] ;
  sflo:observedContentDigest "sha256:d5e2f2939b554391c8ec69e00f388138e754753b11216a3f6199ceb8e5e8634b" .

<ontology/shacl/FoundingReferentDataShape/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .
