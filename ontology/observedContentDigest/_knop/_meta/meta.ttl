@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/observedContentDigest/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/observedContentDigest" ;
  sflo:hasWorkingKnopInventoryFile <ontology/observedContentDigest/_knop/_inventory/inventory.ttl> .
