@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasObservedTargetState> sflo:hasReferenceLink <ontology/hasObservedTargetState/_knop/_references#reference001> .

<ontology/hasObservedTargetState/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <ontology/hasObservedTargetState> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <ontology/hasObservedTargetState/_knop/_references#reference001-source> .

<ontology/hasObservedTargetState/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:hasTargetArtifact <ontology> .
