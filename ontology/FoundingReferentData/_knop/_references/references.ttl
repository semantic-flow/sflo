@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/FoundingReferentData> sflo:hasReferenceLink <ontology/FoundingReferentData/_knop/_references#reference001> .

<ontology/FoundingReferentData/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <ontology/FoundingReferentData> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <ontology/FoundingReferentData/_knop/_references#reference001-source> .

<ontology/FoundingReferentData/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:targetArtifact <ontology> ;
  sflo:targetHistoricalState <ontology/releases/v0.5.0> .
