@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/targetArtifactHistory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/targetArtifactHistory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/targetArtifactHistory/_knop/_inventory/inventory.ttl> .
