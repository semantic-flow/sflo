@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/contentDigestMethodToken> sflo:hasReferenceLink <ontology/contentDigestMethodToken/_knop/_references#reference001> .

<ontology/contentDigestMethodToken/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <ontology/contentDigestMethodToken> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <ontology/contentDigestMethodToken/_knop/_references#reference001-source> .

<ontology/contentDigestMethodToken/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:targetArtifact <ontology> ;
  sflo:targetHistoricalState <ontology/releases/v0.4.0> .
