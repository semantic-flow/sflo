@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/contentDigestMethodToken/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/contentDigestMethodToken" ;
