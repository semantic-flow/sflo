@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/targetArtifact/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/targetArtifact" ;
  sflo:hasWorkingKnopInventoryFile <ontology/targetArtifact/_knop/_inventory/inventory.ttl> .
