@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasWorkingLocatedFile> sflo:hasReferenceLink <ontology/hasWorkingLocatedFile/_knop/_references#reference001> .

<ontology/hasWorkingLocatedFile/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <ontology/hasWorkingLocatedFile> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <ontology/hasWorkingLocatedFile/_knop/_references#reference001-source> .

<ontology/hasWorkingLocatedFile/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:targetArtifact <ontology> ;
  sflo:targetHistoricalState <ontology/releases/v0.3.0> .
