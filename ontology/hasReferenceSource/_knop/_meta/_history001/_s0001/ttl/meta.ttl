@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasReferenceSource/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasReferenceSource" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasReferenceSource/_knop/_inventory/inventory.ttl> .
