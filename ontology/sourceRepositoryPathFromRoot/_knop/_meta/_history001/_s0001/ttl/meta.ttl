@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/sourceRepositoryPathFromRoot/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/sourceRepositoryPathFromRoot" ;
  sflo:hasWorkingKnopInventoryFile <ontology/sourceRepositoryPathFromRoot/_knop/_inventory/inventory.ttl> .
