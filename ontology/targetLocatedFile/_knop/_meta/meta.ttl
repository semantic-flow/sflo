@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/targetLocatedFile/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/targetLocatedFile" ;
  sflo:hasWorkingKnopInventoryFile <ontology/targetLocatedFile/_knop/_inventory/inventory.ttl> .
