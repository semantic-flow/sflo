@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/targetRepositorySource/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/targetRepositorySource" ;
  sflo:hasWorkingKnopInventoryFile <ontology/targetRepositorySource/_knop/_inventory/inventory.ttl> .
