@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ContentDigestMethod/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ContentDigestMethod" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ContentDigestMethod/_knop/_inventory/inventory.ttl> .
