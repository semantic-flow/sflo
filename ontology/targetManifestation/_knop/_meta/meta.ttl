@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/targetManifestation/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/targetManifestation" ;
  sflo:hasWorkingKnopInventoryFile <ontology/targetManifestation/_knop/_inventory/inventory.ttl> .
