@base <https://semantic-flow.github.io/sflo/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/observedTargetLocalRelativePath/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/observedTargetLocalRelativePath" ;
  sflo:hasWorkingKnopInventoryFile <ontology/observedTargetLocalRelativePath/_knop/_inventory/inventory.ttl> .
