<config/_knop> a sflo:Knop ;
  sflo:hasWorkingKnopInventoryFile <config/_knop/_inventory/inventory.ttl> ;
  sflo:hasResourcePage <config/_knop/index.html> .

<config/_knop/_inventory/inventory.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<_mesh> sflo:hasKnop <ontology/shacl/_knop> .

<ontology/shacl> a sflo:PayloadArtifact, sflo:DigitalArtifact, sflo:RdfDocument ;
